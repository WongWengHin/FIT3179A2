{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 355,
  "background": null,
  "padding": {
    "left": 4,
    "right": 8,
    "top": 5,
    "bottom": 3
  },
  "data": {
    "values": []
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial, sans-serif",
      "titleFont": "Arial, sans-serif",
      "labelColor": "#64756e",
      "titleColor": "#64756e",
      "labelFontSize": 10,
      "titleFontSize": 10,
      "gridColor": "#e7eae3",
      "tickColor": "#cbd4cc",
      "domainColor": "#cbd4cc",
      "titlePadding": 7
    },
    "legend": {
      "labelFont": "Arial, sans-serif",
      "titleFont": "Arial, sans-serif",
      "labelColor": "#62736a",
      "titleColor": "#334a3f",
      "labelFontSize": 10,
      "orient": "bottom",
      "symbolSize": 65
    },
    "text": {
      "font": "Arial, sans-serif"
    }
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3,
    "color": "#4a856b"
  },
  "encoding": {
    "y": {
      "field": "abbr",
      "type": "nominal",
      "sort": "-x",
      "axis": {
        "title": null,
        "labelLimit": 55,
        "ticks": false
      }
    },
    "x": {
      "field": "tonnes",
      "type": "quantitative",
      "axis": {
        "title": "Tonnes",
        "format": "~s"
      }
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal"
      },
      {
        "field": "tonnes",
        "type": "quantitative",
        "format": ",.0f"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "National share (%)",
        "format": ".1f"
      }
    ]
  }
}
